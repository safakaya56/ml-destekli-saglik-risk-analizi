# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/health_risk_db?retryWrites=true&w=majority

# JWT Secret Key for Auth
JWT_SECRET=your_jwt_secret_key_here

# FastAPI ML Service URL
ML_SERVICE_URL=http://localhost:8000

# Google Gemini API Key for LLM Clinical Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=5000
